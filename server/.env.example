# ========================================================
# ArogyaDesk Server Environment Configuration
# ========================================================

# Server Port (Default: 5000)
PORT=5000

# Node Environment ('development' | 'production' | 'test')
NODE_ENV=development

# MongoDB Atlas Connection URI
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://wizardo7699_db_user:bLfiL81FPe6SFm6g@cluster0.3ebzkfx.mongodb.net/arogyadesk?retryWrites=true&w=majority&appName=Cluster0

# Use embedded in-memory MongoDB (set 'false' to use MongoDB Atlas)
USE_MEMORY_DB=false

# JSON Web Token Secret (At least 32 characters in production)
JWT_SECRET=arogyadesk_jwt_super_secret_production_key_32bytes_minimum

# Cookie signing secret
COOKIE_SECRET=arogyadesk_cookie_super_secret_encryption_key_2026

# Client frontend URL for CORS origin validation
# Local development: http://localhost:5173
# Production (e.g. Vercel): https://your-arogyadesk.vercel.app
CLIENT_URL=http://localhost:5173
